# ---------------------------------------------------------------------------
# shorts-factory — credentials for the installed research skills.
#
#   cp .env.example .env    then fill in the keys you actually intend to use.
#
# .env is gitignored. No key here is filled in for you: every value below is a
# placeholder, and a skill that needs a missing key should say so rather than
# invent one. Nothing calls a paid endpoint until you supply a key AND ask for
# a run, so an unfilled .env leaves every skill in prose/analysis mode.
# ---------------------------------------------------------------------------

# --- REQUIRED for the ScrapeCreators data layer (13 skills) -----------------
# Powers: outlier-post-finder, transcript-intelligence, comment-mining,
# competitor-social-research, trend-discovery, creator-profile-teardown,
# audience-research, social-listening-brief, product-demand-research,
# influencer-prospecting, content-repurposing, ad-library-teardown,
# scrapecreators-api.
# Key: https://scrapecreators.com  ·  Docs: https://docs.scrapecreators.com
# Metered per request.
SCRAPECREATORS_API_KEY=

# --- REQUIRED for head-of-content TikTok / Instagram / X research ----------
# Apify actors: clockworks/tiktok-scraper, apify/instagram-scraper,
# apidojo/tweet-scraper. Used by tiktok-research, instagram-research, x-research.
# Token: https://console.apify.com/account/integrations
# Metered per actor run. The X/Twitter actor needs a paid Apify plan.
APIFY_TOKEN=

# --- REQUIRED for YouTube outlier detection --------------------------------
# TubeLab Outliers + Transcripts API. Used by youtube-research.
# Key: https://tubelab.net/settings/api
TUBELAB_API_KEY=

# --- REQUIRED for AI video analysis ----------------------------------------
# Gemini analyses downloaded videos for hooks/structure/CTA.
# Used by video-content-analyzer, and by tiktok-research + instagram-research
# when they analyse their top videos.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- OPTIONAL --------------------------------------------------------------
# mcp-builder's evaluation harness only (scripts/evaluation.py). Not needed to
# write an MCP server, only to score one.
ANTHROPIC_API_KEY=

# brand-kit: override where brand/style presets are read from and written to.
# Defaults are fine; set these only if you keep presets outside the project.
VIDEO_STUDIO_BRANDS=
VIDEO_STUDIO_STYLES=

# --- OPTIONAL: media sourcing (scrollmark video-production track only) ------
# None of these are needed for research, ideation, or scripting. They are read
# by studio-setup/scripts/doctor.py and the media/audio acquisition skills.
# Run `python3 .claude/skills/studio-setup/scripts/doctor.py` to see live status.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Unsplash: secondary photography for ASSET_HUNTER. Attribution and
# download-tracking are required by Unsplash's API terms; the server does both.
UNSPLASH_ACCESS_KEY=
FREESOUND_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
# MINIMAX_API_KEY and SHUTTERSTOCK_TOKEN are billed per clip — leave unset
# unless you have deliberately decided to spend on generated media.

# last30days research skill — needs Python 3.12+; this container ships 3.11.
# Provision once with:  uv python install 3.12 && uv python find 3.12
# Also set in .claude/settings.json so every session picks it up.
LAST30DAYS_PYTHON=
