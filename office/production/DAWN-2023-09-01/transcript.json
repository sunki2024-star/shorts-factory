{
  "backend": "whisper",
  "language": "ko",
  "segments": [
    {
      "start": 309.0,
      "end": 311.34,
      "text": "하늘을 가다가 다멘색에 가까이 이르더니"
    },
    {
      "start": 311.34,
      "end": 315.54,
      "text": "호련히 하늘로부터 빛이 그를 둘러 비치는지라"
    },
    {
      "start": 315.54,
      "end": 318.84,
      "text": "땅에 엉뜰여져 들으면 소리가 있어 이르시되"
    },
    {
      "start": 318.84,
      "end": 322.68,
      "text": "사오라 사오라 내가 어찌하여 나를 박해하느냐 하시거늘"
    },
    {
      "start": 322.68,
      "end": 325.74,
      "text": "대답하되 주여 누구시니까 이르시되"
    },
    {
      "start": 325.74,
      "end": 327.84,
      "text": "나는 내가 박해하는 예수라"
    },
    {
      "start": 327.84,
      "end": 330.16,
      "text": "너는 일어나 신으로 들어가라"
    },
    {
      "start": 330.16,
      "end": 333.52,
      "text": "내가 행할 것을 내게 이를 자가 있느니라 하시니"
    },
    {
      "start": 333.52,
      "end": 337.28,
      "text": "같이 가던 사람들은 소리만 듣고 아무도 보지 못하여"
    },
    {
      "start": 337.28,
      "end": 338.64,
      "text": "말을 못하고 서 있더라"
    },
    {
      "start": 338.64,
      "end": 341.12,
      "text": "사오리 땅에서 일어난 눈은 떴으나"
    },
    {
      "start": 341.12,
      "end": 344.22,
      "text": "아무것도 보지 못하고 사람의 손에 끌려"
    },
    {
      "start": 344.22,
      "end": 347.68,
      "text": "다멘색으로 들어가서 사흘 동안 보지 못하고"
    },
    {
      "start": 347.68,
      "end": 350.74,
      "text": "먹지도 마시지도 아니하니라"
    },
    {
      "start": 350.74,
      "end": 351.44,
      "text": "아멘"
    },
    {
      "start": 351.44,
      "end": 356.65999999999997,
      "text": "드디어 사도 바울이 등장하게 됩니다"
    },
    {
      "start": 356.65999999999997,
      "end": 360.32,
      "text": "스테반이 순교할 때"
    },
    {
      "start": 360.32,
      "end": 365.48,
      "text": "사오리라는 사람은 가멜리아 리엘의 문화에서 배워가지고"
    },
    {
      "start": 365.48,
      "end": 367.62,
      "text": "최고의 선생님으로부터 배워서"
    },
    {
      "start": 368.28,
      "end": 370.84000000000003,
      "text": "굉장히 잘 알고 있으니까"
    },
    {
      "start": 370.84000000000003,
      "end": 374.48,
      "text": "사람들이 그 스테반을 죽였을 때도"
    },
    {
      "start": 374.48,
      "end": 376.22,
      "text": "거기다 옷을 맡아 줘 가지고"
    },
    {
      "start": 376.22,
      "end": 379.9,
      "text": "너가 진짜 증언자가 되어 달라"
    },
    {
      "start": 379.9,
      "end": 385.52,
      "text": "너가 잘하니까 율법을 어겨서 죽게 된 것이 마땅한지"
    },
    {
      "start": 385.52,
      "end": 388.48,
      "text": "이제 사오리는 그런 어떤 학식을 가지고 있었고"
    },
    {
      "start": 388.48,
      "end": 391.5,
      "text": "성경을 잘 알고 있던 사람이었지만"
    },
    {
      "start": 391.5,
      "end": 395.92,
      "text": "그러나 영적인 눈이 어두워지는 사람이죠"
    },
    {
      "start": 395.92,
      "end": 397.92,
      "text": "만나지 않으면 영적인 눈이 어두워지죠"
    },
    {
      "start": 397.92,
      "end": 399.68,
      "text": "영적인 눈이 어둡습니다"
    },
    {
      "start": 399.68,
      "end": 403.3,
      "text": "하나님을 만나면 또 성경이 완전히 새롭게"
    },
    {
      "start": 403.3,
      "end": 405.7,
      "text": "우리 가운데 다가오는 거죠"
    },
    {
      "start": 405.7,
      "end": 410.14,
      "text": "그래서 우리는 하나님을 만날 수 있도록"
    },
    {
      "start": 410.14,
      "end": 411.82,
      "text": "위해서 기도해 줘야 됩니다"
    },
    {
      "start": 411.82,
      "end": 416.14,
      "text": "스테반이 죽으면서 하나님 저들의 죄를 용서해 주십시오"
    },
    {
      "start": 416.14,
      "end": 420.7,
      "text": "아마 특별히 사도 바울을 봤으리라고 생각을 합니다"
    },
    {
      "start": 420.7,
      "end": 422.74,
      "text": "하나님 저들의 죄를 용서해 주십시오"
    },
    {
      "start": 422.74,
      "end": 427.56,
      "text": "왜냐하면 사도 바울이 스테반의 그 장면을 늘 새기게 되고"
    },
    {
      "start": 427.56,
      "end": 431.26,
      "text": "그 다음에 사도 바울은 사람들을 만나서 전도할 때마다"
    },
    {
      "start": 431.26,
      "end": 433.44,
      "text": "너희들은 나의 멸류관이다"
    },
    {
      "start": 433.44,
      "end": 438.78,
      "text": "멸류관이라는 단어 원어로 보면 멸류관이 스테반이에요"
    },
    {
      "start": 438.78,
      "end": 441.14,
      "text": "그러니까 늘 스테반을 생각을 하면서"
    },
    {
      "start": 441.14,
      "end": 444.8,
      "text": "스테반 때문에 내가 이렇게 변화되고"
    },
    {
      "start": 444.8,
      "end": 446.56,
      "text": "주님 앞에 쓰임 받을 수 있구나"
    },
    {
      "start": 446.56,
      "end": 450.36,
      "text": "그러니까 이거는 뭐 성경에 그렇게 나오지는 않지만"
    },
    {
      "start": 450.36,
      "end": 453.84000000000003,
      "text": "그러나 늘 멸류관이라는 단어를 썼다는 것"
    },
    {
      "start": 453.84000000000003,
      "end": 456.36,
      "text": "늘 스테반 스테반 생각을 하고 있었다는 것은"
    },
    {
      "start": 456.36,
      "end": 457.38,
      "text": "그의 기도가 되었고"
    },
    {
      "start": 457.56,
      "end": 459.5,
      "text": "그의 기도를 늘 기억하고 있었다는 거죠"
    },
    {
      "start": 459.5,
      "end": 461.96000000000004,
      "text": "그래서 우리는 그런 추론이 가능합니다"
    },
    {
      "start": 461.96000000000004,
      "end": 466.72,
      "text": "스테반의 기도로 마이미암아서 사도 바울이 쓰임 받게 됐다"
    },
    {
      "start": 466.72,
      "end": 468.1,
      "text": "그렇게 생각을 할 수 있습니다"
    },
    {
      "start": 468.1,
      "end": 471.46000000000004,
      "text": "그런데 이 사울이라는 사람이 어떠하셨습니까"
    },
    {
      "start": 471.46000000000004,
      "end": 472.9,
      "text": "9장 1절에 보면"
    },
    {
      "start": 472.9,
      "end": 477.53999999999996,
      "text": "그 스테반의 그런 사건이 생겼음에도 불구하고"
    },
    {
      "start": 477.53999999999996,
      "end": 480.88,
      "text": "안 변화되는 것처럼 보여요"
    },
    {
      "start": 480.88,
      "end": 485.32,
      "text": "참 보면 뭔가 우리가 변화되기를 원하는 사람 보면"
    },
    {
      "start": 485.32,
      "end": 487.38,
      "text": "이런 거를 한번 생각해보세요"
    },
    {
      "start": 487.56,
      "end": 490.8,
      "text": "한번 경험했으면 변화될 것 같은데"
    },
    {
      "start": 490.8,
      "end": 497.18,
      "text": "오히려 더 이렇게 다른 길로 나아가고 있는 경우를 보는 적이 있잖아요"
    },
    {
      "start": 497.18,
      "end": 499.74,
      "text": "그런 사람들이 생각이 나겠죠"
    },
    {
      "start": 499.74,
      "end": 503.3,
      "text": "그런데 사울이 주의 제자들에 대하여서"
    },
    {
      "start": 503.3,
      "end": 509.22,
      "text": "여전히 여전히 여전히 그렇네"
    },
    {
      "start": 509.22,
      "end": 514.26,
      "text": "더 심해지네 왜 빨리 안 변화될까"
    },
    {
      "start": 514.26,
      "end": 516.3199999999999,
      "text": "우리 마음속에 그런 생각이 있잖아요"
    },
    {
      "start": 516.3199999999999,
      "end": 517.54,
      "text": "그런데 여전히 위협까지 있는 그런 생각이 있잖아요."
    },
    {
      "start": 517.56,
      "end": 522.28,
      "text": "위협과 살기가 등등하여 등등하다라는 것은 숨을 쉰다는 거예요"
    },
    {
      "start": 522.28,
      "end": 526.44,
      "text": "그러니까 호흡조차도 위협과 살기로 다 가득 찼다는 거예요"
    },
    {
      "start": 526.44,
      "end": 533.04,
      "text": "그러니까 우리가 어떤 사람을 위해서 기도할 때 보면"
    },
    {
      "start": 533.04,
      "end": 539.5,
      "text": "저 사람 예수님 믿었으면 좋겠다 이렇게 생각하고"
    },
    {
      "start": 539.5,
      "end": 543.1,
      "text": "하나님의 뜻을 좀 알았으면 좋겠다 이렇게 생각을 하는데"
    },
    {
      "start": 543.1,
      "end": 546.5,
      "text": "여전히 위협과 살기가 등등하여서"
    },
    {
      "start": 547.56,
      "end": 550.56,
      "text": "이제 대제사장에게로 이제 가가지고"
    },
    {
      "start": 550.56,
      "end": 553.52,
      "text": "2절 말씀해 보면 다메색 여러 회당에"
    },
    {
      "start": 553.52,
      "end": 557.4,
      "text": "다메색에는 한 유대인이 4, 5만 명 정도 있었고"
    },
    {
      "start": 557.4,
      "end": 562.36,
      "text": "그 다음에 회당 회당이 한 20개 정도 이렇게 있었다고 합니다"
    },
    {
      "start": 562.36,
      "end": 565.54,
      "text": "30개 정도 있었다고 하는데"
    },
    {
      "start": 565.54,
      "end": 570.4200000000001,
      "text": "그 회당에 가져갈 공문을 청하니 회당으로 이제 공문을 가져가려고"
    },
    {
      "start": 570.4200000000001,
      "end": 576.9200000000001,
      "text": "사내들인 공의에서 이제 사법권 이런 것들을 잡을 수 있는 권한을 받아가지고"
    },
    {
      "start": 577.56,
      "end": 582.94,
      "text": "다메색에 가서 그 지역에 가서 그 지역의 회당에 가가지고"
    },
    {
      "start": 582.94,
      "end": 588.54,
      "text": "공문을 공문에 이렇게 보여주면서 이제 아마 거기에서"
    },
    {
      "start": 588.54,
      "end": 592.22,
      "text": "보세요 이는 만일 그 도를 따르는 사람을 만나면"
    },
    {
      "start": 592.22,
      "end": 595.9,
      "text": "남녀를 막론하고 결박하여 예루살렘으로 잡아오려 함이라"
    },
    {
      "start": 595.9,
      "end": 600.7,
      "text": "그러니까 회당에서 그리스도인들이 모였다는 것을 알 수가 있죠"
    },
    {
      "start": 600.7,
      "end": 605.72,
      "text": "늘 회당에 모여가지고 말씀 듣고 기도하고 그랬습니다"
    },
    {
      "start": 605.72,
      "end": 607.54,
      "text": "그러니까 회당으로 한 번에"
    },
    {
      "start": 607.56,
      "end": 611.76,
      "text": "한 30개 정도 회당을 이제 가면서 거기에 그리스도를 따르는 사람들이 있으면"
    },
    {
      "start": 611.76,
      "end": 615.62,
      "text": "잡아가지고 죽이려고 예루살렘으로 끌고 와서 죽이려고 했던 거예요"
    },
    {
      "start": 615.62,
      "end": 625.6800000000001,
      "text": "근데 3절 말씀 한번 우리 3절 말씀 한번 읽겠습니다"
    },
    {
      "start": 625.6800000000001,
      "end": 626.3,
      "text": "시작"
    },
    {
      "start": 626.3,
      "end": 629.56,
      "text": "사울이 길을 가다가 다메색에 가까이 이르더니"
    },
    {
      "start": 629.56,
      "end": 633.8,
      "text": "호련이 하늘로부터 빛이 그를 둘러 비추는지라"
    },
    {
      "start": 633.8,
      "end": 636.3399999999999,
      "text": "자 여기 보면요"
    },
    {
      "start": 636.3399999999999,
      "end": 637.54,
      "text": "2절 말씀입니다"
    },
    {
      "start": 637.56,
      "end": 640.02,
      "text": "2절 말씀에 보면 만일 그 도를 따르는 사람"
    },
    {
      "start": 640.02,
      "end": 641.6600000000001,
      "text": "그 도는 누구의 돌까요"
    },
    {
      "start": 641.6600000000001,
      "end": 644.12,
      "text": "예수 그리스도의 도를 따르는 사람"
    },
    {
      "start": 644.12,
      "end": 647.88,
      "text": "근데 이 도라는 말은 길을 의미합니다"
    },
    {
      "start": 647.88,
      "end": 654.36,
      "text": "그러니까 예수님을 그냥 뭐 알지 못하고 그냥 쫓아가는 거를 얘기하는 게 아니라"
    },
    {
      "start": 654.36,
      "end": 656.3,
      "text": "길이 정해져 있어가지고"
    },
    {
      "start": 656.3,
      "end": 662.54,
      "text": "예수 그리스도의 길이 뭔지를 알고 그 길로 가는 사람들"
    },
    {
      "start": 662.54,
      "end": 666.96,
      "text": "그러니까 그때 당시 예수님을 믿는 사람들은"
    },
    {
      "start": 666.96,
      "end": 667.54,
      "text": "확실하게 예수님을 믿는 사람들은"
    },
    {
      "start": 667.56,
      "end": 669.88,
      "text": "예수님의 길이 뭔지를 알았던 거예요"
    },
    {
      "start": 669.88,
      "end": 673.0,
      "text": "그러니까 모르고 쫓아간 게 아니고"
    },
    {
      "start": 673.0,
      "end": 679.24,
      "text": "예수님에 대해서 예수님을 믿는 길은 이 길이다라는 걸 확실히 알고"
    },
    {
      "start": 679.24,
      "end": 681.52,
      "text": "길을 갈아탔다는 겁니다"
    },
    {
      "start": 681.52,
      "end": 683.6600000000001,
      "text": "그 길을 걷고 있고요"
    },
    {
      "start": 683.6600000000001,
      "end": 688.8399999999999,
      "text": "근데 여기 보면 3절에 보면 사울이 길을 가다가 했잖아요"
    },
    {
      "start": 688.8399999999999,
      "end": 691.38,
      "text": "사울이 갔던 길은 완전히 무슨 길이에요?"
    },
    {
      "start": 691.88,
      "end": 693.76,
      "text": "다른 길이었단 말이에요"
    },
    {
      "start": 693.76,
      "end": 696.6,
      "text": "그런데 사울이 그 다른 길"
    },
    {
      "start": 696.6,
      "end": 697.54,
      "text": "예수님을 믿는 길이 뭔지 알았던 거예요"
    },
    {
      "start": 697.56,
      "end": 699.88,
      "text": "예수님을 모르고 대적하는 그 길을 가다가"
    },
    {
      "start": 699.88,
      "end": 702.8399999999999,
      "text": "그 길은 악한 길이에요"
    },
    {
      "start": 702.8399999999999,
      "end": 705.86,
      "text": "결국에는 더 심해지는 길이고"
    },
    {
      "start": 705.86,
      "end": 709.1600000000001,
      "text": "마귀 권수가 있는 길이니까 어떻게 됩니까?"
    },
    {
      "start": 709.24,
      "end": 710.1800000000001,
      "text": "더 악해집니다"
    },
    {
      "start": 710.1800000000001,
      "end": 714.9,
      "text": "그러니까 사도바울이 위협과 살기가 숨으로 가득 차는 거죠"
    },
    {
      "start": 714.9,
      "end": 717.74,
      "text": "처음에는 그렇게 안 했다가 나중에 그 길을 가면"
    },
    {
      "start": 717.74,
      "end": 720.4200000000001,
      "text": "점점 대적하는 길로 가고"
    },
    {
      "start": 720.4200000000001,
      "end": 722.7,
      "text": "악한 길로 가고 그렇게 되는데"
    },
    {
      "start": 722.7,
      "end": 726.7,
      "text": "그 길을 가다가 홀연히 빛이 비쳐가지고요"
    },
    {
      "start": 727.56,
      "end": 731.94,
      "text": "거기서 야! 너 그 길로 가면 안 돼"
    },
    {
      "start": 731.94,
      "end": 736.3399999999999,
      "text": "홀연히 하나님께서 강권적으로 역사하셔가지고"
    },
    {
      "start": 736.3399999999999,
      "end": 739.98,
      "text": "이 사람은 나중에 그 길에서 다른 길로"
    },
    {
      "start": 739.98,
      "end": 743.52,
      "text": "예수 그리스도의 길로 가게 되는 일이 생기게 되는 거죠"
    },
    {
      "start": 743.52,
      "end": 747.1800000000001,
      "text": "저는 이 사도바울의 일을 생각할 때마다"
    },
    {
      "start": 747.1800000000001,
      "end": 751.9200000000001,
      "text": "우리 가족이나 아니면 우리 친척이나"
    },
    {
      "start": 751.9200000000001,
      "end": 753.36,
      "text": "아니면 우리 이웃 중에"
    },
    {
      "start": 753.36,
      "end": 756.14,
      "text": "정말로 구원 받아야 되는데"
    },
    {
      "start": 756.14,
      "end": 757.54,
      "text": "주님을 믿고 가고"
    },
    {
      "start": 757.56,
      "end": 759.48,
      "text": "그 길을 모르고 딴 길로 가는 사람들 보면"
    },
    {
      "start": 759.48,
      "end": 765.06,
      "text": "우리 그런 신앙인들은 그런 마음들이 있었던 것 같아요"
    },
    {
      "start": 765.06,
      "end": 769.14,
      "text": "아이고 저러다가 고꾸라지지"
    },
    {
      "start": 769.14,
      "end": 771.14,
      "text": "저러다가 고꾸라지지"
    },
    {
      "start": 771.14,
      "end": 774.6600000000001,
      "text": "여전히 위협과 살기가 가득해가지고 저러다가"
    },
    {
      "start": 774.6600000000001,
      "end": 778.02,
      "text": "아이고 참 자기가 하는 일도 모르지만"
    },
    {
      "start": 778.02,
      "end": 779.98,
      "text": "그러다가 하나님 앞에 어떻게 돼요?"
    },
    {
      "start": 780.56,
      "end": 782.3,
      "text": "완전히 고꾸라지지"
    },
    {
      "start": 782.3,
      "end": 786.52,
      "text": "그런 생각을 하면 참 뭐라 그럴까요"
    },
    {
      "start": 786.52,
      "end": 787.54,
      "text": "마음이"
    },
    {
      "start": 787.56,
      "end": 790.96,
      "text": "그 사람을 향해서 굉장히 뭐라 그래요"
    },
    {
      "start": 790.96,
      "end": 796.1,
      "text": "그 사람이 구원 받겠다라는 소망으로 가득 차잖아요"
    },
    {
      "start": 796.1,
      "end": 800.76,
      "text": "사도바울도 예수 믿는 사람들을 대적하면서"
    },
    {
      "start": 800.76,
      "end": 803.3399999999999,
      "text": "살기가 가득했는데 그러다 고꾸라졌잖아요"
    },
    {
      "start": 803.3399999999999,
      "end": 809.52,
      "text": "여러분 여러분들 주변에 다른 길로 가고 있는 사람들이 있습니까?"
    },
    {
      "start": 809.52,
      "end": 813.6600000000001,
      "text": "그리고 변함없이 나한테 큰소리 치고"
    },
    {
      "start": 813.6600000000001,
      "end": 815.88,
      "text": "교만하고 그런 사람들이 있습니까?"
    },
    {
      "start": 816.52,
      "end": 817.3199999999999,
      "text": "그럼 주님 앞에?"
    },
    {
      "start": 817.56,
      "end": 819.72,
      "text": "고꾸라지지 저러다가"
    },
    {
      "start": 819.72,
      "end": 823.24,
      "text": "아 저 이 말이 되게 좋더라고요"
    },
    {
      "start": 823.24,
      "end": 826.54,
      "text": "주님 앞에 그러다가 항복하게 되지"
    },
    {
      "start": 826.54,
      "end": 833.7,
      "text": "주님이 그냥 가만두실 것 같으냐"
    },
    {
      "start": 833.7,
      "end": 836.56,
      "text": "그 얘기는 뭐냐면 처벌받는다라는 얘기가 아니라"
    },
    {
      "start": 836.56,
      "end": 839.56,
      "text": "내가 기도하고 있는데 저러다가"
    },
    {
      "start": 839.56,
      "end": 842.46,
      "text": "지는 뭐 지 잘났다 그러고"
    },
    {
      "start": 842.46,
      "end": 844.6,
      "text": "그러다가 하나님 앞에 어떻게 된다?"
    },
    {
      "start": 844.92,
      "end": 845.92,
      "text": "고꾸라지지"
    },
    {
      "start": 847.56,
      "end": 849.92,
      "text": "사도바울도 그랬는데 뭐 고꾸라지지"
    },
    {
      "start": 849.92,
      "end": 852.98,
      "text": "저러다가 천부여 의지 없어서 하나님께 돌아오게 되지"
    },
    {
      "start": 852.98,
      "end": 857.62,
      "text": "이렇게 생각을 하면 되게 마음이 좋더라고요"
    },
    {
      "start": 857.62,
      "end": 861.92,
      "text": "그래 저렇게 딴 길로 가는데 내가 기도하고 있는데"
    },
    {
      "start": 861.92,
      "end": 866.06,
      "text": "저러다 저 녀석 저러다가 하나님 앞에 두 손 두 발 들고"
    },
    {
      "start": 866.06,
      "end": 869.4,
      "text": "다 돌아오게 되지 이렇게 생각을 하고 있는 거죠"
    },
    {
      "start": 869.4,
      "end": 872.96,
      "text": "나의 배우자도 마찬가지인 줄 믿으시길 바랍니다"
    },
    {
      "start": 872.96,
      "end": 876.22,
      "text": "저렇게 하나님 모르고 이렇게 가다가"
    },
    {
      "start": 876.22,
      "end": 877.54,
      "text": "결국에는 나의 배우자도 마찬가지인 줄 믿으시길 바랍니다"
    },
    {
      "start": 877.56,
      "end": 879.66,
      "text": "내가 기도하는데 항복하게 되지"
    },
    {
      "start": 879.66,
      "end": 883.98,
      "text": "여러분 그런 역사가 우리 가운데 있다는 거예요"
    },
    {
      "start": 883.98,
      "end": 886.24,
      "text": "그럴 때 그게 얼마나 은혜가 되겠습니까"
    },
    {
      "start": 886.24,
      "end": 891.62,
      "text": "우리는 그래서 항상 소망을 갖게 됩니다"
    },
    {
      "start": 891.62,
      "end": 896.34,
      "text": "보면은 딴 길로 가고 있는 사랑하는 사람"
    },
    {
      "start": 896.34,
      "end": 901.76,
      "text": "뭐 이렇게 예수님만 얘기하면 승질 내는 사람"
    },
    {
      "start": 901.76,
      "end": 906.48,
      "text": "아이고 속으로 웃으면서 저러다가"
    },
    {
      "start": 906.48,
      "end": 907.54,
      "text": "결국은 내가 기도하는데"
    },
    {
      "start": 907.56,
      "end": 911.08,
      "text": "결국에는 하나님 앞에 두 손 들고 돌아오게 되지"
    },
    {
      "start": 911.08,
      "end": 913.3,
      "text": "왜냐하면 기도하고 있으니까"
    },
    {
      "start": 913.3,
      "end": 918.56,
      "text": "그렇게 여러분들 믿음 가지고 나가실 여러분들이 되시기를 추구합니다"
    },
    {
      "start": 918.56,
      "end": 925.3,
      "text": "보세요 숨소리까지도 위협과 살기로 가득했던 사람"
    },
    {
      "start": 925.3,
      "end": 927.78,
      "text": "그리고 다른 길로 가던 사람"
    },
    {
      "start": 927.78,
      "end": 934.06,
      "text": "근데 그 누구도 하나님의 일하심을 막을 수가 없었다는 거예요"
    },
    {
      "start": 934.06,
      "end": 935.6,
      "text": "그죠?"
    },
    {
      "start": 935.6,
      "end": 936.64,
      "text": "보면?"
    },
    {
      "start": 937.56,
      "end": 939.76,
      "text": "그런 역사가 있습니다"
    },
    {
      "start": 939.76,
      "end": 944.48,
      "text": "아무리 기세 등등 해도 그냥 속으로 먹으려 생각하는 거죠"
    },
    {
      "start": 944.48,
      "end": 947.68,
      "text": "저러다 하나님 앞에 돌아오게 되지"
    },
    {
      "start": 947.68,
      "end": 949.8,
      "text": "예 하나님께서 어떤 일을 하셨냐"
    },
    {
      "start": 949.8,
      "end": 953.96,
      "text": "사울아 사울아 내가 어찌하여 나를 받게 하느냐"
    },
    {
      "start": 953.96,
      "end": 957.18,
      "text": "호련이 빛이 갑자기 어느 날"
    },
    {
      "start": 957.18,
      "end": 959.28,
      "text": "확 이런 놀란 일이 생기는 거예요"
    },
    {
      "start": 959.28,
      "end": 961.2,
      "text": "하나님의 때가 있습니다"
    },
    {
      "start": 961.2,
      "end": 966.52,
      "text": "기도가 쌓이면 어느 날 하나님께서 결정하시고"
    },
    {
      "start": 966.52,
      "end": 970.38,
      "text": "호련이 하늘로부터 빛이 비추는 거예요"
    },
    {
      "start": 970.38,
      "end": 974.14,
      "text": "이 사람은 이거 외에는 구원받을 길이 없으니까"
    },
    {
      "start": 974.14,
      "end": 976.64,
      "text": "하나님이 최후의 수단을 쓰신 겁니다"
    },
    {
      "start": 976.64,
      "end": 980.08,
      "text": "강력한 수단을 쓰신 거예요"
    },
    {
      "start": 980.08,
      "end": 982.56,
      "text": "어떤 사람이 이걸 부러워하긴 하지만"
    },
    {
      "start": 982.56,
      "end": 984.78,
      "text": "그러나 다른 식으로 생각하면"
    },
    {
      "start": 984.78,
      "end": 986.36,
      "text": "얼마나 마음이 완고했길래"
    },
    {
      "start": 986.36,
      "end": 987.98,
      "text": "하나님이 그런 방법을 쓰시나"
    },
    {
      "start": 987.98,
      "end": 989.84,
      "text": "이렇게 생각하면 되지"
    },
    {
      "start": 989.84,
      "end": 991.16,
      "text": "어 사도벌 되게 부럽다"
    },
    {
      "start": 991.16,
      "end": 993.32,
      "text": "이렇게 생각할 필요는 없어요"
    },
    {
      "start": 993.32,
      "end": 996.32,
      "text": "오히려 조그마한 그런 은혜를"
    },
    {
      "start": 996.32,
      "end": 999.66,
      "text": "보고도 조그마한 역사를 보고도"
    },
    {
      "start": 999.66,
      "end": 1001.46,
      "text": "죽게 돌아온 자가 더 복이 있다"
    },
    {
      "start": 1001.46,
      "end": 1003.22,
      "text": "그런 생각이 듭니다"
    },
    {
      "start": 1003.22,
      "end": 1005.36,
      "text": "근데 하나님께서는 마침내 그냥"
    },
    {
      "start": 1005.36,
      "end": 1007.86,
      "text": "이 친구는 구원받아야 되는데"
    },
    {
      "start": 1007.86,
      "end": 1010.78,
      "text": "너무 이렇게 위협과 살기로 등등하고"
    },
    {
      "start": 1010.78,
      "end": 1011.76,
      "text": "죽음으로 가고"
    },
    {
      "start": 1011.76,
      "end": 1013.44,
      "text": "스대반의 기도가 있었고"
    },
    {
      "start": 1013.44,
      "end": 1016.3,
      "text": "이러니까 하나님께서 마침내"
    },
    {
      "start": 1016.3,
      "end": 1020.98,
      "text": "호련이 하늘로부터 빛을 비추는 줄 알고"
    },
    {
      "start": 1020.98,
      "end": 1022.7,
      "text": "강권하는 거죠"
    },
    {
      "start": 1022.7,
      "end": 1024.44,
      "text": "그 다음에 얘 어떻게 돼요"
    },
    {
      "start": 1024.44,
      "end": 1026.12,
      "text": "땅에 엎드려졌다"
    },
    {
      "start": 1026.12,
      "end": 1027.96,
      "text": "확 쓰러지는데"
    },
    {
      "start": 1027.96,
      "end": 1032.0,
      "text": "여러분들 그런 역사가 있는 줄 믿으시기 바랍니다"
    },
    {
      "start": 1032.0,
      "end": 1033.92,
      "text": "아무리 완고한 사람도"
    },
    {
      "start": 1033.92,
      "end": 1036.06,
      "text": "우리가 기도하고 있는 이상"
    },
    {
      "start": 1036.06,
      "end": 1039.1799999999998,
      "text": "땅에 확 쓰러집니다"
    },
    {
      "start": 1039.1799999999998,
      "end": 1042.06,
      "text": "그리고 나서 소리가 있어 이르되"
    },
    {
      "start": 1042.06,
      "end": 1046.52,
      "text": "사우라 사우라 내가 어찌하여 나를 박해하느냐"
    },
    {
      "start": 1046.52,
      "end": 1047.4,
      "text": "나를 박해한다"
    },
    {
      "start": 1047.4,
      "end": 1049.62,
      "text": "교회를 박해 했는데 나를 박해 했다고 그래요"
    },
    {
      "start": 1049.62,
      "end": 1050.72,
      "text": "맞죠"
    },
    {
      "start": 1050.72,
      "end": 1053.8600000000001,
      "text": "교회는 예수 그리스를 머리로 하여서"
    },
    {
      "start": 1053.8600000000001,
      "end": 1055.92,
      "text": "우리는 예수 그리스도의 몸이잖아요"
    },
    {
      "start": 1055.92,
      "end": 1058.3600000000001,
      "text": "그러니까 그리스도인들을 박해하면"
    },
    {
      "start": 1058.3600000000001,
      "end": 1059.6399999999999,
      "text": "그리스도를 박해하는 겁니다"
    },
    {
      "start": 1059.6399999999999,
      "end": 1062.12,
      "text": "왜냐면 우리는 그리스도의 몸이니까"
    },
    {
      "start": 1062.12,
      "end": 1063.04,
      "text": "꼭 기억하십시오"
    },
    {
      "start": 1063.04,
      "end": 1065.92,
      "text": "나는 그리스도의 몸이다"
    },
    {
      "start": 1065.92,
      "end": 1067.6799999999998,
      "text": "나는 몸이다"
    },
    {
      "start": 1067.6799999999998,
      "end": 1071.8,
      "text": "얼마나 우리의 신분이 정말 고귀합니까"
    },
    {
      "start": 1071.8,
      "end": 1074.46,
      "text": "나는 그리스도의 몸이야"
    },
    {
      "start": 1074.46,
      "end": 1075.8,
      "text": "나를 박해"
    },
    {
      "start": 1075.8,
      "end": 1078.88,
      "text": "그러면 나를 박해한다고 생각하지 말고"
    },
    {
      "start": 1078.88,
      "end": 1080.48,
      "text": "너 예수님을 박해하는 거다"
    },
    {
      "start": 1080.48,
      "end": 1082.4,
      "text": "그러다가 큰 코 다친다"
    },
    {
      "start": 1082.4,
      "end": 1084.08,
      "text": "너 회심하게 돼"
    },
    {
      "start": 1084.08,
      "end": 1085.72,
      "text": "나는 예수님의 몸이기 때문에"
    },
    {
      "start": 1085.72,
      "end": 1089.8,
      "text": "참 예수님의 몸이라는 게 얼마나 감사한지"
    },
    {
      "start": 1089.8,
      "end": 1093.6599999999999,
      "text": "예수님도 우리를 자기 몸으로 생각하니까"
    },
    {
      "start": 1093.6599999999999,
      "end": 1097.28,
      "text": "예수님이 우리를 지켜보시고"
    },
    {
      "start": 1097.28,
      "end": 1099.78,
      "text": "우리를 소중히 여기시고"
    },
    {
      "start": 1099.78,
      "end": 1102.58,
      "text": "본인으로 생각하시는 거예요"
    },
    {
      "start": 1102.58,
      "end": 1104.98,
      "text": "그걸 꼭 아셨으면 좋겠습니다"
    },
    {
      "start": 1104.98,
      "end": 1107.46,
      "text": "그러니까 우리가 기도하는 것도"
    },
    {
      "start": 1107.46,
      "end": 1111.9,
      "text": "예수님이 예수님의 이름으로 기도하지 않습니까"
    },
    {
      "start": 1111.9,
      "end": 1113.96,
      "text": "예수님의 몸의 지체인데"
    },
    {
      "start": 1113.96,
      "end": 1115.52,
      "text": "몸의 지체가 아프다 그러면"
    },
    {
      "start": 1115.52,
      "end": 1117.8200000000002,
      "text": "여러분들 우리 몸 아프면"
    },
    {
      "start": 1117.8200000000002,
      "end": 1121.02,
      "text": "우리는 당장 치료받으려고 어떻게든지 생각하잖아요"
    },
    {
      "start": 1121.02,
      "end": 1124.74,
      "text": "그런 것처럼 하나님이 우리의 기도를 생각하신다라는 것을"
    },
    {
      "start": 1124.74,
      "end": 1126.78,
      "text": "꼭 기억하셨으면 좋겠습니다"
    },
    {
      "start": 1126.78,
      "end": 1131.3,
      "text": "여러분들 아프면 결국에는 좀 참다가"
    },
    {
      "start": 1131.3,
      "end": 1133.3600000000001,
      "text": "결국에는 치료받도록 하잖아요"
    },
    {
      "start": 1133.3600000000001,
      "end": 1135.9,
      "text": "그러니까 치료합니다"
    },
    {
      "start": 1135.9,
      "end": 1138.1599999999999,
      "text": "결국에 자기 몸에 소속된 부분은"
    },
    {
      "start": 1138.1599999999999,
      "end": 1140.54,
      "text": "참다 참다가 너무 통증이 심해지면"
    },
    {
      "start": 1140.54,
      "end": 1143.48,
      "text": "결국엔 내 몸이니까 치료한다 그래요"
    },
    {
      "start": 1143.48,
      "end": 1145.3200000000002,
      "text": "기도도 마찬가지예요"
    },
    {
      "start": 1145.3200000000002,
      "end": 1148.3,
      "text": "예수님의 몸이 기도하고 있는데"
    },
    {
      "start": 1148.3,
      "end": 1149.9,
      "text": "아프다고 기도하고 있는데"
    },
    {
      "start": 1149.9,
      "end": 1151.74,
      "text": "똑같아요"
    },
    {
      "start": 1151.74,
      "end": 1154.0,
      "text": "그래서 예수님도 결국에는"
    },
    {
      "start": 1154.0,
      "end": 1157.08,
      "text": "그것을 통해서 역사하실 수밖에 없다라는 것이죠"
    },
    {
      "start": 1157.08,
      "end": 1160.5,
      "text": "대답하되 주여 누구시니까 이르시되"
    },
    {
      "start": 1160.5,
      "end": 1162.26,
      "text": "나는 네가 받게 하는 예수라"
    },
    {
      "start": 1162.26,
      "end": 1164.4,
      "text": "너는 이제 일어나라"
    },
    {
      "start": 1164.4,
      "end": 1166.88,
      "text": "일어나서 이제 시내로 들어가라"
    },
    {
      "start": 1166.88,
      "end": 1168.26,
      "text": "다른 길로 가라"
    },
    {
      "start": 1168.26,
      "end": 1170.3600000000001,
      "text": "가라 이제 담의 색으로 이제"
    },
    {
      "start": 1170.3600000000001,
      "end": 1171.98,
      "text": "시내에 가라"
    },
    {
      "start": 1171.98,
      "end": 1174.72,
      "text": "내가 행할 것을 내게 이를 자가 있느니라"
    },
    {
      "start": 1174.72,
      "end": 1175.12,
      "text": "이제"
    },
    {
      "start": 1175.12,
      "end": 1179.6599999999999,
      "text": "그 예수 그리스를 대적하는 길로 가다가"
    },
    {
      "start": 1179.6599999999999,
      "end": 1181.78,
      "text": "예수 그리스의 길로 가야 되지 않습니까"
    },
    {
      "start": 1181.78,
      "end": 1184.88,
      "text": "그런데 일어나서"
    },
    {
      "start": 1184.88,
      "end": 1187.4,
      "text": "이제 들어라는 거죠"
    },
    {
      "start": 1187.4,
      "end": 1189.96,
      "text": "이제 그 길로 어떻게 가는지를"
    },
    {
      "start": 1189.96,
      "end": 1193.1,
      "text": "길을 바깥하는 거를 이제 듣게 된 거예요"
    },
    {
      "start": 1193.1,
      "end": 1195.24,
      "text": "그게 복음의 말씀입니다"
    },
    {
      "start": 1195.24,
      "end": 1199.7,
      "text": "그걸 듣고 이제 복 있는 자의 길로 가라는 거죠"
    },
    {
      "start": 1199.7,
      "end": 1202.1599999999999,
      "text": "그런데 7절 말씀 보시면요"
    },
    {
      "start": 1202.1599999999999,
      "end": 1204.92,
      "text": "같이 가던 사람들은 소리만 듣고"
    },
    {
      "start": 1204.92,
      "end": 1207.0,
      "text": "소리만 듣고"
    },
    {
      "start": 1207.0,
      "end": 1211.1799999999998,
      "text": "아무도 보지 못하여 말을 못하고 서 있더라"
    },
    {
      "start": 1211.1799999999998,
      "end": 1214.92,
      "text": "소리는 다 같이 들었어요"
    },
    {
      "start": 1214.92,
      "end": 1218.7,
      "text": "사도바울도 듣고 같이 있던 사람도 소리는 들었어요"
    },
    {
      "start": 1218.7,
      "end": 1220.98,
      "text": "그런데 사도바울은 뭐를 들었습니까"
    },
    {
      "start": 1220.98,
      "end": 1224.38,
      "text": "소리 안에 음성을 들었어요"
    },
    {
      "start": 1224.38,
      "end": 1227.8600000000001,
      "text": "그런데 다른 사람들은 소리는 들었는데"
    },
    {
      "start": 1227.8600000000001,
      "end": 1230.02,
      "text": "음성은 못 들었단 말이에요"
    },
    {
      "start": 1230.02,
      "end": 1234.72,
      "text": "여러분들 그래서 말씀이라는 것도 똑같습니다"
    },
    {
      "start": 1234.72,
      "end": 1240.0,
      "text": "하나님 말씀을 듣는데 소리로 듣지 않게 하시고"
    },
    {
      "start": 1240.0,
      "end": 1243.92,
      "text": "뭐로 들리도록 예수님의 음성으로 들리도록"
    },
    {
      "start": 1243.92,
      "end": 1245.8200000000002,
      "text": "하나님 역사하여 주시옵소서"
    },
    {
      "start": 1245.8200000000002,
      "end": 1250.38,
      "text": "그래서 교회에 사랑하는 사람들이 이제 오고 막 그럴 때"
    },
    {
      "start": 1250.38,
      "end": 1252.6399999999999,
      "text": "우리가 위에서 기도해 줘야 됩니다"
    },
    {
      "start": 1252.6399999999999,
      "end": 1254.88,
      "text": "하나님 말씀이 송포될 때"
    },
    {
      "start": 1254.88,
      "end": 1257.78,
      "text": "단순히 소리로 듣지 않게 하시고"
    },
    {
      "start": 1257.78,
      "end": 1262.6399999999999,
      "text": "예수님의 음성으로 들려주게 하여 주시옵소서"
    },
    {
      "start": 1262.6399999999999,
      "end": 1264.7,
      "text": "그러니까 또 한 번"
    },
    {
      "start": 1264.7,
      "end": 1266.3,
      "text": "똑같이 있어도요"
    },
    {
      "start": 1266.3,
      "end": 1271.44,
      "text": "똑같이 소리가 전파되도 소리로만 그치는 사람이 있고"
    },
    {
      "start": 1271.44,
      "end": 1275.8,
      "text": "음성으로 임하는 역사가 있게 됩니다"
    },
    {
      "start": 1275.8,
      "end": 1279.94,
      "text": "그러니까 음성으로 임하는 역사를 위해서 기도해야 되는 거죠"
    },
    {
      "start": 1279.94,
      "end": 1281.74,
      "text": "사획자도 기도해야 되고"
    },
    {
      "start": 1281.74,
      "end": 1285.42,
      "text": "여러분들도 이제 누군가 교회 나온다면"
    },
    {
      "start": 1285.42,
      "end": 1287.38,
      "text": "음성으로 듣게 하는 역사를"
    },
    {
      "start": 1287.38,
      "end": 1292.1799999999998,
      "text": "사도바울에게 나타났던 음성이 들리는 역사를 허락하여 주시옵소서"
    },
    {
      "start": 1292.1799999999998,
      "end": 1294.06,
      "text": "똑같이 소리였어요"
    },
    {
      "start": 1294.06,
      "end": 1294.5,
      "text": "소리였는데"
    },
    {
      "start": 1294.5,
      "end": 1296.6399999999999,
      "text": "그게 신기하죠"
    },
    {
      "start": 1296.6399999999999,
      "end": 1298.98,
      "text": "이 소리가 똑같이 가잖아요"
    },
    {
      "start": 1298.98,
      "end": 1301.22,
      "text": "소리는 누구에게나 다 갑니다"
    },
    {
      "start": 1301.22,
      "end": 1304.38,
      "text": "근데 소리가 도달하는 순간 뭐로 바뀌어요?"
    },
    {
      "start": 1304.94,
      "end": 1306.44,
      "text": "음성으로 바뀐다고요"
    },
    {
      "start": 1306.44,
      "end": 1308.28,
      "text": "그러니까 우리 가운데도"
    },
    {
      "start": 1308.28,
      "end": 1311.42,
      "text": "묵상이나 하나님 말씀을 연구할 때도"
    },
    {
      "start": 1311.42,
      "end": 1312.06,
      "text": "뭐예요?"
    },
    {
      "start": 1312.24,
      "end": 1313.6599999999999,
      "text": "똑같이 글자가 오지만"
    },
    {
      "start": 1313.6599999999999,
      "end": 1316.74,
      "text": "끝에 나한테 도달할 때는 뭘로 와야 돼요?"
    },
    {
      "start": 1317.6599999999999,
      "end": 1319.04,
      "text": "음성으로 와야 된다고요"
    },
    {
      "start": 1319.04,
      "end": 1320.08,
      "text": "그죠?"
    },
    {
      "start": 1320.6,
      "end": 1323.24,
      "text": "여러분들 그 옛날에 전화기 놀이에 한 거 있잖아요"
    },
    {
      "start": 1323.24,
      "end": 1324.3,
      "text": "컵에다가 실 연결하고"
    },
    {
      "start": 1324.3,
      "end": 1325.0,
      "text": "그죠?"
    },
    {
      "start": 1325.42,
      "end": 1327.22,
      "text": "저쪽에다가 어떤 컵을 연결하잖아요"
    },
    {
      "start": 1327.22,
      "end": 1330.02,
      "text": "내가 여기에서 음성으로 얘기하잖아요"
    },
    {
      "start": 1330.02,
      "end": 1332.12,
      "text": "근데 그게 줄을 타고는 뭐예요?"
    },
    {
      "start": 1333.54,
      "end": 1335.24,
      "text": "그 소리 신호로 가잖아요"
    },
    {
      "start": 1335.24,
      "end": 1338.66,
      "text": "음성 신호로 가"
    },
    {
      "start": 1338.66,
      "end": 1339.84,
      "text": "신호로 그냥"
    },
    {
      "start": 1339.84,
      "end": 1341.38,
      "text": "그 줄을 타고는"
    },
    {
      "start": 1341.38,
      "end": 1343.1,
      "text": "신호로 가는데"
    },
    {
      "start": 1343.1,
      "end": 1345.24,
      "text": "그 끝에 또 뭐로 바뀝니까?"
    },
    {
      "start": 1345.38,
      "end": 1346.44,
      "text": "음성으로 바뀌잖아요"
    },
    {
      "start": 1346.44,
      "end": 1349.28,
      "text": "그게 바로"
    },
    {
      "start": 1349.28,
      "end": 1352.04,
      "text": "하나님의 말씀이라는 게"
    },
    {
      "start": 1352.04,
      "end": 1354.1,
      "text": "하나님 나에게 음성으로 들려주기 때문에"
    },
    {
      "start": 1354.1,
      "end": 1355.38,
      "text": "들려주게 하여 주시옵소서"
    },
    {
      "start": 1355.38,
      "end": 1359.58,
      "text": "분명히 그냥 별 거 아니라고 들었는데"
    },
    {
      "start": 1359.58,
      "end": 1363.34,
      "text": "그게 나한테 어느 날 꽝 친단 말이죠"
    },
    {
      "start": 1363.34,
      "end": 1364.04,
      "text": "그게 뭐예요?"
    },
    {
      "start": 1364.62,
      "end": 1365.58,
      "text": "음성이잖아요"
    },
    {
      "start": 1365.58,
      "end": 1367.02,
      "text": "그러니까 우리는"
    },
    {
      "start": 1367.02,
      "end": 1370.32,
      "text": "내 양은 내 음성을 듣느니라"
    },
    {
      "start": 1370.32,
      "end": 1372.76,
      "text": "라고 얘기를 주님께서 하신 거예요"
    },
    {
      "start": 1372.76,
      "end": 1373.7,
      "text": "그러니까 우리는"
    },
    {
      "start": 1373.7,
      "end": 1375.58,
      "text": "그거를 하시는 분이 누구십니까?"
    },
    {
      "start": 1375.68,
      "end": 1376.52,
      "text": "성령님이시죠?"
    },
    {
      "start": 1377.14,
      "end": 1378.86,
      "text": "그러니까 성령님 말씀 읽을 때"
    },
    {
      "start": 1378.86,
      "end": 1380.4,
      "text": "그 말씀이 문자가 아니라"
    },
    {
      "start": 1380.4,
      "end": 1382.14,
      "text": "음성이 되게 하여 주시옵소서"
    },
    {
      "start": 1382.14,
      "end": 1384.06,
      "text": "저 분이"
    },
    {
      "start": 1384.06,
      "end": 1385.56,
      "text": "또 교회에 나와서 들을 때"
    },
    {
      "start": 1385.56,
      "end": 1388.68,
      "text": "소리가 아니라 음성이 되게 하여 주시옵소서"
    },
    {
      "start": 1388.68,
      "end": 1389.76,
      "text": "이렇게 기도하시는"
    },
    {
      "start": 1389.76,
      "end": 1391.2,
      "text": "여러분들 되시기를 추구합니다"
    },
    {
      "start": 1391.2,
      "end": 1393.44,
      "text": "음성이 들리니까"
    },
    {
      "start": 1393.44,
      "end": 1395.26,
      "text": "이제 하나님을 만나게 되는 거예요"
    },
    {
      "start": 1395.26,
      "end": 1396.74,
      "text": "예수님을 만나게 되는 거예요"
    },
    {
      "start": 1396.74,
      "end": 1400.34,
      "text": "그리고 얼마나 충격적이었는지"
    },
    {
      "start": 1400.34,
      "end": 1402.28,
      "text": "자기가 예수님을"
    },
    {
      "start": 1402.28,
      "end": 1402.98,
      "text": "핍박했는데"
    },
    {
      "start": 1402.98,
      "end": 1406.02,
      "text": "예수님의 음성을 들어버린 거라"
    },
    {
      "start": 1406.02,
      "end": 1408.04,
      "text": "예수님 없다고 막 이러면서"
    },
    {
      "start": 1408.04,
      "end": 1409.5,
      "text": "죽었다고 막 이렇게"
    },
    {
      "start": 1409.5,
      "end": 1411.14,
      "text": "막 생각하고"
    },
    {
      "start": 1411.14,
      "end": 1414.02,
      "text": "예수 믿는 자를 핍박하고"
    },
    {
      "start": 1414.02,
      "end": 1417.58,
      "text": "성경이 예수님에 대해서 얘기하는데"
    },
    {
      "start": 1417.58,
      "end": 1418.4,
      "text": "그걸 못 보고"
    },
    {
      "start": 1418.4,
      "end": 1419.82,
      "text": "다른 길로 갔는데"
    },
    {
      "start": 1419.82,
      "end": 1422.66,
      "text": "나는 네가 박해하는 예수라"
    },
    {
      "start": 1422.66,
      "end": 1423.8,
      "text": "음성을 들은 거예요"
    },
    {
      "start": 1423.8,
      "end": 1426.64,
      "text": "그러니 얼마나"
    },
    {
      "start": 1426.64,
      "end": 1429.08,
      "text": "이제 송두리째 자기의 삶이"
    },
    {
      "start": 1429.08,
      "end": 1430.38,
      "text": "충격을 받았습니까"
    },
    {
      "start": 1430.38,
      "end": 1432.9,
      "text": "다 박해된다니까요"
    },
    {
      "start": 1432.9,
      "end": 1433.6,
      "text": "꼬꾸라지고"
    },
    {
      "start": 1433.6,
      "end": 1436.94,
      "text": "재밌더라고요 사울 보면서"
    },
    {
      "start": 1436.94,
      "end": 1438.3,
      "text": "아이고"
    },
    {
      "start": 1438.3,
      "end": 1441.02,
      "text": "지가 그래봤자 누구 손안에 뭐지"
    },
    {
      "start": 1441.02,
      "end": 1442.42,
      "text": "뭐 이런 생각 벼룩이지"
    },
    {
      "start": 1442.42,
      "end": 1443.82,
      "text": "어디로 뛰겠지"
    },
    {
      "start": 1444.02,
      "end": 1446.0,
      "text": "결국에는 꼬꾸라지지"
    },
    {
      "start": 1446.0,
      "end": 1448.52,
      "text": "돌아오게 되지"
    },
    {
      "start": 1448.52,
      "end": 1452.2,
      "text": "근데 8절 9절에 보면"
    },
    {
      "start": 1452.2,
      "end": 1455.36,
      "text": "사울이 땅에서 일어나 눈은 떴으나"
    },
    {
      "start": 1455.36,
      "end": 1458.4,
      "text": "이제 아무것도 보지 못하고"
    },
    {
      "start": 1458.4,
      "end": 1460.86,
      "text": "눈은 떴으나 아무것도 보지 못하고"
    },
    {
      "start": 1460.86,
      "end": 1464.32,
      "text": "이제 진짜 영원한 것을 보게 되는 거죠"
    },
    {
      "start": 1464.32,
      "end": 1465.68,
      "text": "사람의 손에 이끌려서"
    },
    {
      "start": 1465.68,
      "end": 1467.9,
      "text": "담의 색으로 들어가서 사흘 동안 보지 못하고"
    },
    {
      "start": 1467.9,
      "end": 1469.62,
      "text": "먹지도 마시지도"
    },
    {
      "start": 1469.62,
      "end": 1472.64,
      "text": "아니 아니라 음성을 들으니"
    },
    {
      "start": 1472.64,
      "end": 1473.98,
      "text": "그 가운데 이제"
    },
    {
      "start": 1473.98,
      "end": 1476.24,
      "text": "결국에는 육신의 것은"
    },
    {
      "start": 1476.24,
      "end": 1478.42,
      "text": "먹지도 못하고 보지도 못하고"
    },
    {
      "start": 1478.42,
      "end": 1481.12,
      "text": "그랬지만은 영적인 것이 열려서"
    },
    {
      "start": 1481.12,
      "end": 1483.16,
      "text": "영원한 하나님 나라"
    },
    {
      "start": 1483.16,
      "end": 1484.9,
      "text": "예수 그리스도의 생명"
    },
    {
      "start": 1484.9,
      "end": 1486.8,
      "text": "그거를 발견하는 역사가"
    },
    {
      "start": 1486.8,
      "end": 1488.78,
      "text": "일어나게 되었다는 것입니다"
    },
    {
      "start": 1488.78,
      "end": 1491.52,
      "text": "우리 이 말씀을 보면서"
    },
    {
      "start": 1491.52,
      "end": 1492.58,
      "text": "기도해야 되겠죠"
    },
    {
      "start": 1492.58,
      "end": 1495.98,
      "text": "그죠 하나님 사울과 같이"
    },
    {
      "start": 1495.98,
      "end": 1499.22,
      "text": "저 사람에게도 그런 역사가 일어날 줄로 믿습니다"
    },
    {
      "start": 1499.22,
      "end": 1500.96,
      "text": "아니면은 뭐"
    },
    {
      "start": 1500.96,
      "end": 1503.36,
      "text": "지금 오늘 메시지를 듣고 있는"
    },
    {
      "start": 1503.36,
      "end": 1503.94,
      "text": "또 인터넷에서"
    },
    {
      "start": 1503.94,
      "end": 1505.48,
      "text": "듣고 있는"
    },
    {
      "start": 1505.48,
      "end": 1508.3,
      "text": "혹시 분들 중에서"
    },
    {
      "start": 1508.3,
      "end": 1509.9,
      "text": "정말로 주님에 대해"
    },
    {
      "start": 1509.9,
      "end": 1511.64,
      "text": "누군지 내가"
    },
    {
      "start": 1511.64,
      "end": 1514.78,
      "text": "그동안 많이 모르고 살았다 그러면"
    },
    {
      "start": 1514.78,
      "end": 1516.9,
      "text": "주님 나에게도 이제"
    },
    {
      "start": 1516.9,
      "end": 1519.2,
      "text": "음성이 들리게 하여 주시옵소서"
    },
    {
      "start": 1519.2,
      "end": 1521.08,
      "text": "주님 만나게 하시고"
    },
    {
      "start": 1521.08,
      "end": 1524.04,
      "text": "영원한 생명을 보게 하여 주십시오"
    },
    {
      "start": 1524.04,
      "end": 1525.96,
      "text": "이 주님 안에서"
    },
    {
      "start": 1525.96,
      "end": 1528.94,
      "text": "또 진지한 시간을 가지며"
    },
    {
      "start": 1528.94,
      "end": 1531.26,
      "text": "이제 내가 어느 길로 걸어가야 되겠다"
    },
    {
      "start": 1531.26,
      "end": 1533.18,
      "text": "결단하는 시간이"
    },
    {
      "start": 1533.18,
      "end": 1533.9,
      "text": "우리가 근데"
    },
    {
      "start": 1533.9,
      "end": 1534.9,
      "text": "필요한 줄로"
    },
    {
      "start": 1534.9,
      "end": 1536.76,
      "text": "생각을 합니다"
    },
    {
      "start": 1536.76,
      "end": 1538.62,
      "text": "그 길은 정녕"
    },
    {
      "start": 1538.62,
      "end": 1539.94,
      "text": "폭된 길입니다"
    },
    {
      "start": 1539.94,
      "end": 1542.74,
      "text": "영생의 길이죠"
    },
    {
      "start": 1542.74,
      "end": 1544.9,
      "text": "이제 그거를 발견했으면"
    },
    {
      "start": 1544.9,
      "end": 1547.98,
      "text": "그 길로 가는 겁니다"
    },
    {
      "start": 1547.98,
      "end": 1551.22,
      "text": "우리 꾸준히 가자구요"
    },
    {
      "start": 1551.22,
      "end": 1553.54,
      "text": "예수 그리스도의 길에 있잖아요"
    },
    {
      "start": 1553.54,
      "end": 1555.94,
      "text": "예수 그리스도의 몸이잖아요"
    },
    {
      "start": 1555.94,
      "end": 1557.74,
      "text": "그 길 보이잖아요"
    },
    {
      "start": 1557.74,
      "end": 1559.34,
      "text": "그 길의 끝에"
    },
    {
      "start": 1559.34,
      "end": 1561.34,
      "text": "영원한 천국이 있고"
    },
    {
      "start": 1561.34,
      "end": 1563.86,
      "text": "하나님의 빛나는 보좌가 있고"
    },
    {
      "start": 1563.86,
      "end": 1566.84,
      "text": "그 수많은 천국의 입성은"
    },
    {
      "start": 1566.84,
      "end": 1567.86,
      "text": "하얀 옷을 입은"
    },
    {
      "start": 1567.86,
      "end": 1569.5,
      "text": "수많은 믿음의 선진들이"
    },
    {
      "start": 1569.5,
      "end": 1570.82,
      "text": "거기에 있는"
    },
    {
      "start": 1570.82,
      "end": 1572.92,
      "text": "저 천국 문이 보이잖아요"
    },
    {
      "start": 1572.92,
      "end": 1574.88,
      "text": "예수 그리스도"
    },
    {
      "start": 1574.88,
      "end": 1576.06,
      "text": "몸으로"
    },
    {
      "start": 1576.06,
      "end": 1579.68,
      "text": "가서 예수 그리스를 만나게 되고"
    },
    {
      "start": 1579.68,
      "end": 1581.34,
      "text": "몸이"
    },
    {
      "start": 1581.34,
      "end": 1582.06,
      "text": "이제"
    },
    {
      "start": 1582.06,
      "end": 1584.14,
      "text": "몸에 이제 영원토록 붙어서"
    },
    {
      "start": 1584.14,
      "end": 1586.54,
      "text": "계속 우리 가고 있잖아요"
    },
    {
      "start": 1586.54,
      "end": 1588.52,
      "text": "그 길로 이제 가고 있습니다"
    },
    {
      "start": 1588.52,
      "end": 1591.72,
      "text": "그런 우리 모두가 되시기를"
    },
    {
      "start": 1591.72,
      "end": 1593.82,
      "text": "음"
    },
    {
      "start": 1593.82,
      "end": 1595.18,
      "text": "그리고"
    },
    {
      "start": 1595.18,
      "end": 1598.72,
      "text": "낙심하지 마세요"
    },
    {
      "start": 1598.72,
      "end": 1599.46,
      "text": "뭐"
    },
    {
      "start": 1599.46,
      "end": 1600.48,
      "text": "하나님 앞에"
    },
    {
      "start": 1600.48,
      "end": 1601.66,
      "text": "우리가 기도하고 있는데"
    },
    {
      "start": 1601.66,
      "end": 1602.94,
      "text": "뭐"
    },
    {
      "start": 1602.94,
      "end": 1604.96,
      "text": "얼마나 오래가겠어"
    },
    {
      "start": 1604.96,
      "end": 1607.24,
      "text": "두 손 두 발 다 들고"
    },
    {
      "start": 1607.24,
      "end": 1609.34,
      "text": "주님 앞에 나온다"
    },
    {
      "start": 1609.34,
      "end": 1610.0,
      "text": "하나님 소리가"
    }
  ],
  "sermon_window": {
    "start": 309.0,
    "end": 1610.0
  }
}